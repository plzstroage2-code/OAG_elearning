# Local demo is the default. Do not put production credentials in chat.
APP_MODE=demo
APP_ORIGIN=http://localhost:3100
DATA_DRIVER=file
# Demo code: ICTC-DEMO (only in demo mode). In live mode set your own strong code.
# ADMIN_ACCESS_CODE=
# CODE_EXPIRES_AT=2026-12-31T16:59:00Z
# Live deployment: DATA_DRIVER=postgres, APP_MODE=live, APP_ORIGIN=https://your-host
# DATABASE_URL=postgresql://... Supabase transaction pooler URL (server only)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_REALTIME_EVENT=ictc-main
